@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IConflictApiClient Api
@inject MapState State

<section class="card map-card" aria-labelledby="map-title">
    <header class="card-header">
        <h2 id="map-title">Väpnade konflikter @State.Year</h2>
        @if (!loading && error is null)
        {
            <p class="muted">@stats.Count länder med konflikt</p>
        }
    </header>

    <div class="map-wrapper">
        <div @ref="mapElement" class="map" role="img"
             aria-label="Världskarta där länder färgas efter antal dödsfall. Samma data finns i listan."></div>

        @if (loading)
        {
            <div class="map-overlay"><span class="spinner" aria-hidden="true"></span> Laddar kartan…</div>
        }
        else if (error is not null)
        {
            <div class="map-overlay" role="alert">
                <p>@error</p>
                <button class="btn" @onclick="RetryAsync">Försök igen</button>
            </div>
        }
    </div>

    <ul class="legend" aria-label="Färgförklaring, dödsfall per land">
        <li><span class="swatch" style="background:#fde68a"></span>0–24</li>
        <li><span class="swatch" style="background:#f59e0b"></span>25–999</li>
        <li><span class="swatch" style="background:#c2410c"></span>1 000–9 999</li>
        <li><span class="swatch" style="background:#7f1d1d"></span>10 000+</li>
        <li><span class="swatch swatch-outline"></span>Markerat land</li>
    </ul>
</section>

@code {
    private ElementReference mapElement;
    private IJSObjectReference? module;
    private DotNetObjectReference<WorldMap>? selfRef;
    private CancellationTokenSource? cts;

    private bool mapReady;
    private bool loading = true;
    private string? error;
    private IReadOnlyList<CountryStatDto> stats = [];

    protected override void OnInitialized()
    {
        // OBSERVER: lyssna på det delade tillståndet
        State.Changed += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // JavaScript kan bara anropas när komponenten finns i webbläsaren
        if (firstRender)
            await InitMapAsync();
    }

    private async Task InitMapAsync()
    {
        try
        {
            loading = true;
            error = null;
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/map.js");
            selfRef ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("init", mapElement, selfRef, "data/countries.geojson");
            mapReady = true;

            await LoadStatsAsync();
            await ApplyHighlightAsync(zoom: false);
        }
        catch (Exception)
        {
            error = "Kartan kunde inte laddas.";
            loading = false;
            StateHasChanged();
        }
    }

    private void OnStateChanged(StateChange change)
    {
        _ = InvokeAsync(async () =>
        {
            if (!mapReady) return;

            // Nytt år eller filter: hämta nya siffror
            if (change.HasFlag(StateChange.Filters))
                await LoadStatsAsync();

            // Nya markerade länder: rita om, och zooma om det kom från chatten
            if (change.HasFlag(StateChange.Highlight))
                await ApplyHighlightAsync(zoom: change.HasFlag(StateChange.Chat));
        });
    }

    private async Task LoadStatsAsync()
    {
        cts?.Cancel();
        cts = new CancellationTokenSource();
        var token = cts.Token;

        loading = true;
        error = null;
        StateHasChanged();

        try
        {
            stats = await Api.GetCountryStatsAsync(State.Year, token);
            if (module is not null)
                await module.InvokeVoidAsync("setStats", token, stats);
        }
        catch (OperationCanceledException)
        {
            return;   // ett nyare anrop har tagit över
        }
        catch (Exception)
        {
            error = "Kunde inte hämta siffrorna för kartan.";
        }

        loading = false;
        StateHasChanged();
    }

    private async Task ApplyHighlightAsync(bool zoom)
    {
        if (module is null) return;
        await module.InvokeVoidAsync("setHighlight", State.HighlightedCountries, State.CountryIso, zoom);
    }

    private async Task RetryAsync()
    {
        if (mapReady) await LoadStatsAsync();
        else await InitMapAsync();
    }

    /// <summary>Anropas från map.js när användaren klickar på ett land.</summary>
    [JSInvokable]
    public void OnCountryClicked(string iso)
    {
        // Klick på samma land igen tar bort valet
        var same = string.Equals(iso, State.CountryIso, StringComparison.OrdinalIgnoreCase);
        State.SelectCountry(same ? null : iso);
    }

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        cts?.Cancel();

        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Webbläsaren är redan stängd
            }
        }

        selfRef?.Dispose();
    }
}