@inherits LayoutComponentBase

<a class="skip-link" href="#main">Hoppa till innehållet</a>

<div class="app">
    <header class="app-header">
        <a class="brand" href="">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>Konfliktkartan</span>
        </a>
        <p class="tagline">Väpnade konflikter i världen, med data från UCDP</p>
    </header>

    <main id="main" class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        <p>
            Data: <a href="https://ucdp.uu.se" target="_blank" rel="noopener">Uppsala Conflict Data Program (UCDP)</a>.
            AI:n hämtar alla siffror från databasen.
        </p>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Något gick fel.
    <a href="." class="reload">Ladda om</a>
    <span class="dismiss">✕</span>
</div>